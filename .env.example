# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# Neon Postgres connection string.
# Get it from the Neon dashboard (Project → Connection Details → pooled string).
# On Netlify, set the same variable in: Site settings → Environment variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Admin session signing secret (JWT). Generate a random 32-byte base64 string.
AUTH_SECRET="generate-a-random-32-byte-base64-string"

# Email (contact form: forward to the company + auto-reply to the applicant).
# Any SMTP provider works. For Zoho Mail: host smtp.zoho.com, port 465, secure
# true, user = the mailbox, pass = an app-specific password (Zoho > Security >
# App Passwords). Leave unset to disable emails (leads are still saved to the DB).
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@studyabroad.lk"
SMTP_PASS="your-smtp-app-password"
MAIL_FROM="Study Abroad (Pvt) Ltd <info@studyabroad.lk>"
# Where new-enquiry notifications are sent (defaults to MAIL_FROM if unset).
LEADS_NOTIFY_TO="info@studyabroad.lk"
